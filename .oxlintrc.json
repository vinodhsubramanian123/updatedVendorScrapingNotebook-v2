{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "caughtErrors": "none",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-control-regex": "off",
    "unicorn/prefer-string-starts-ends-with": "off"
  },
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "no-unused-vars": "off",
        "unicorn/no-useless-spread": "off",
        "unicorn/no-new-array": "off",
        "no-unused-expressions": "off"
      }
    }
  ]
}
