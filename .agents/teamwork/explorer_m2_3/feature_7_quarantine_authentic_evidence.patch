+/**
+ * Resolve an authentic session file under outputs/history/oca_sessions/.
+ * Guarded against path traversal.
+ * @param {string} evidenceRef
+ * @param {string} sessionsDir
+ * @returns {string|null}
+ */
+function resolveSessionFile(evidenceRef, sessionsDir) {
+  if (!evidenceRef || typeof evidenceRef !== 'string') return null;
+  const trimmed = evidenceRef.trim();
+  if (!trimmed || trimmed.includes('\0') || isSyntheticOrMockToken(trimmed)) return null;
+
+  const targetSessionsDir = sessionsDir || DEFAULT_OCA_SESSIONS_DIR;
+  const normSessions = path.normalize(targetSessionsDir);
+
+  const resolved = path.isAbsolute(trimmed)
+    ? path.resolve(trimmed)
+    : path.resolve(targetSessionsDir, trimmed);
+
+  const normResolved = path.normalize(resolved);
+  if (!normResolved.startsWith(normSessions)) {
+    const altResolved = path.resolve(PROJECT_ROOT, trimmed);
+    if (!path.normalize(altResolved).startsWith(normSessions)) return null;
+    if (fs.existsSync(altResolved) && fs.statSync(altResolved).isFile()) return altResolved;
+  }
+
+  if (fs.existsSync(normResolved) && fs.statSync(normResolved).isFile()) return normResolved;
+
+  if (!normResolved.endsWith('.json')) {
+    const withExt = `${normResolved}.json`;
+    if (fs.existsSync(withExt) && fs.statSync(withExt).isFile()) return withExt;
+  }
+
+  // Scan sessions directory for matching sessionId or id property
+  if (fs.existsSync(targetSessionsDir)) {
+    try {
+      const entries = fs.readdirSync(targetSessionsDir, { withFileTypes: true });
+      for (const entry of entries) {
+        if (!entry.isFile() || !entry.name.endsWith('.json')) continue;
+        const candidatePath = path.join(targetSessionsDir, entry.name);
+        try {
+          const content = JSON.parse(fs.readFileSync(candidatePath, 'utf-8'));
+          if (content.sessionId === trimmed || content.id === trimmed) {
+            return candidatePath;
+          }
+        } catch (_) {}
+      }
+    } catch (_) {}
+  }
+
+  return null;
+}
