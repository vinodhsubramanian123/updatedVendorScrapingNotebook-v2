# Node
node_modules/
npm-debug.log*
yarn-error.log

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Scrape outputs — large binaries and generated files
# Keep the directory structure but not the actual data files
outputs/**/*.json
outputs/**/*.xlsx
outputs/**/*.tsv
outputs/**/*.csv
outputs/**/*.pdf
outputs/**/*.html
outputs/**/*.md
outputs/**/*.log
# Always keep the registry and directory structure
!outputs/SCRAPED_CATALOGS.md
!outputs/history/rules/**
!outputs/history/master_knowledge_registry.json

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Scratch / temp
*.crdownload

# Windows
Thumbs.db
Desktop.ini

# Linux
*~
.nfs*


# ── Ephemeral runtime files ──────────────────────────────────────────
dashboard.pid
.env
.chrome_sso_profile/
graphify-out/
*/graphify-out/

# ── Atomic write backup files (created by safeWriteJsonAtomic) ──────
*.bak
*.tmp

# ── Scrape staging dirs (ephemeral — deleted on success promotion) ──
outputs/temp/

# ── Benchmark fixture CSVs (moved to tests/fixtures/) ───────────────
outputs/temp_benchmarks/

# ── Root-level artifact / orphan files ──────────────────────────────
implementation_plan.md

# ── Rogue root directories (phantom chassis output paths) ────────────
/root/
/Output Path/
/-------------/

# ── Garbage notebook sync payloads from test/invalid chassis ────────
outputs/history/notebook_sync_payload_edge-test-*.md
outputs/history/notebook_sync_payload_Unknown_Chassis.md
outputs/history/notebook_sync_payload_tmp_*.md
outputs/history/notebook_sync_payload_outputs.md
