# ==============================================================================
# HPE ProLiant AI Studio & Multi-Vendor BOQ Evaluator — Environment Config
# ==============================================================================

# Server & Dashboard Configuration
PORT=3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# Vendor Portal Credentials & URLs
# ------------------------------------------------------------------------------
# HPE Partner Portal & One Config Advanced (OCA / WebLogic)
# NOTE: If HPE_PORTAL_PASS is empty, browser_launcher.js uses the saved credentials
# inside .chrome_sso_profile for zero-touch authentication.
HPE_PORTAL_USER=hpeconfig@swiftline-uae.com
HPE_PORTAL_PASS=
HPE_PORTAL_URL=https://partner.hpe.com/web/prp
CDP_PORT=9222

# Dell Premier Portal & Solution Configurator (DSA / OSC) [Extensible Multi-Vendor]
DELL_PORTAL_USER=
DELL_PORTAL_PASS=
DELL_PORTAL_URL=https://www.dell.com/premier

# Cisco Commerce Workspace (CCW) [Extensible Multi-Vendor]
CISCO_PORTAL_USER=
CISCO_PORTAL_PASS=
CISCO_PORTAL_URL=https://apps.cisco.com/Commerce/

# Lenovo Data Center Solution Configurator (DCSC) [Extensible Multi-Vendor]
LENOVO_PORTAL_USER=
LENOVO_PORTAL_PASS=
LENOVO_PORTAL_URL=https://dcsc.lenovo.com/

# ------------------------------------------------------------------------------
# Gemini LLM & Autonomous Guardrail Configuration
# ------------------------------------------------------------------------------
# Primary Gemini API Key for Intent DNA and Dual-Brain Guardrail
GEMINI_API_KEY=
# Smart FIFO Rotator Key Pool (comma-separated for autonomous rate limit recovery)
# Primary Gemini Model (standard: gemini-3.6-flash, or latest: gemini-3.8-flash / gemini-3.7-flash)
GEMINI_MODEL_NAME=gemini-3.6-flash
# Fallback model chain for 404/retirement or transient outages
GUARDRAIL_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite
GUARDRAIL_API_TIMEOUT_MS=45000

# ------------------------------------------------------------------------------
# Asynchronous CI/CD & Background Auditing (Optional)
# ------------------------------------------------------------------------------
JULES_API_KEY=
